{
  "manifest_version": 2,
  "name": "Adaptive Dark",
  "version": "0.4.0",
  "description": "Darkens light-only websites: OKLCH lightness inversion with hue kept, stylesheet-level rewriting, smart image handling.",
  "permissions": ["<all_urls>", "storage", "tabs"],
  "background": { "scripts": ["color.js", "background.js"] },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["color.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "browser_action": {
    "default_title": "Adaptive Dark",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "commands": {
    "toggle-site": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Turn Adaptive Dark on or off for the current site"
    }
  },
  "icons": { "48": "icon.svg", "96": "icon.svg" },
  "browser_specific_settings": {
    "gecko": {
      "id": "adaptive-dark@netizen-kruze",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
